#!/bin/sh
#
# vpn_switch - bring up the saved default VPN session at boot and whenever
# the uplink comes back, BEFORE the time daemons: with a firewall that lets
# nothing but the tunnel out, ntpd/openntpd cannot even resolve their
# servers until the VPN egress exists.
#
# Runs vpn-switch as the user whose database holds the sessions (set at
# install time from the user running 'sudo gmake install'), so files under
# the database keep their owner. That user needs passwordless sudo for the
# connect steps (wg-quick, pfctl, resolvconf), see docs/INSTALL.md.
#
# PROVIDE: vpn_switch
# REQUIRE: NETWORKING pf devd
# BEFORE:  ntpdate ntpd openntpd LOGIN
# KEYWORD: shutdown
#
# /etc/rc.conf or /usr/local/etc/rc.conf.d/vpn_switch (written by the installer):
#   vpn_switch_enable="YES"
#   vpn_switch_user="brj"                        # owner of the database
#   vpn_switch_base="/home/<user>/.vpn-switch/db"   # VPN_SWITCH_BASE for that user
#   vpn_switch_ifname="lagg0"                    # uplink to wait for
#   vpn_switch_wait="30"                         # seconds to wait for link + address
#   vpn_switch_session=""                        # saved session; empty = 'default'
#
# The devd rule /usr/local/etc/devd/vpn_switch.conf calls 'linkup' when the
# uplink reports LINK_UP (cable back, lagg failover) - a no-op while a session
# is already connected. At boot the uplink's LINK_UP is queued before devd
# runs, so devd fires 'linkup' long before rc reaches this script -- before
# pf, before the routes: 'linkup' therefore does nothing until 'start' has
# run once this boot (/var/run/vpn_switch.started; /var/run is cleaned at
# boot). Two starts at once (a flapping uplink) are serialized by
# /var/run/vpn_switch.lock, a directory: mkdir is atomic, the loser leaves.

# shellcheck disable=SC2034  # rc.subr reads desc, rcvar and the *_cmd variables
. /etc/rc.subr

name=vpn_switch
desc="VPN session via vpn-switch, before the time daemons"
rcvar=vpn_switch_enable

load_rc_config $name

: "${vpn_switch_enable:="NO"}"
: "${vpn_switch_user:="root"}"
: "${vpn_switch_base:=""}"
: "${vpn_switch_ifname:="lagg0"}"
: "${vpn_switch_wait:="30"}"
: "${vpn_switch_session:=""}"
: "${vpn_switch_command:="/usr/local/bin/vpn-switch"}"
: "${vpn_switch_lock:="/var/run/vpn_switch.lock"}"
: "${vpn_switch_started:="/var/run/vpn_switch.started"}"

extra_commands="status linkup"
start_cmd="vpn_switch_start"
stop_cmd="vpn_switch_stop"
status_cmd="vpn_switch_status"
linkup_cmd="vpn_switch_linkup"

# run_as_user CMD... - vpn-switch in the database owner's context
run_as_user() {
	local cmd="" a
	if [ "$vpn_switch_user" = "root" ]; then
		env VPN_SWITCH_BASE="$vpn_switch_base" "$@"
		return
	fi
	for a in env VPN_SWITCH_BASE="$vpn_switch_base" "$@"; do
		cmd="$cmd '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"
	done
	su -m "$vpn_switch_user" -c "$cmd"
}

vpn_switch_precheck() {
	if [ -z "$vpn_switch_base" ]; then
		local home
		home=$(pw usershow "$vpn_switch_user" 2>/dev/null | cut -d: -f9)
		vpn_switch_base="${home:-/root}/.vpn-switch/db"
	fi
	if [ ! -d "$vpn_switch_base" ]; then
		warn "$name: database $vpn_switch_base not found (vpn_switch_base in rc.conf)"
		return 1
	fi
	[ -x "$vpn_switch_command" ] || { warn "$name: $vpn_switch_command not executable"; return 1; }
}

# connected: a session is up (exit 0) - what makes start/linkup idempotent
connected() {
	run_as_user "$vpn_switch_command" status 2>/dev/null | grep -q 'Connected'
}

# wait_for_uplink: link active and an IPv4 address on the uplink, or timeout
wait_for_uplink() {
	local i=0
	while [ "$i" -lt "$vpn_switch_wait" ]; do
		if ifconfig "$vpn_switch_ifname" 2>/dev/null | grep -q 'status: active' \
		   && ifconfig "$vpn_switch_ifname" 2>/dev/null | grep -q 'inet '; then
			return 0
		fi
		sleep 1; i=$((i + 1))
	done
	warn "$name: $vpn_switch_ifname has no link/address after ${vpn_switch_wait}s"
	return 1
}

# one start at a time: the second caller (rc start vs devd linkup at boot,
# two LINK_UP events of a flapping uplink) sees the lock and leaves
vpn_switch_start() {
	vpn_switch_precheck || return 1
	: > "$vpn_switch_started"
	if ! mkdir "$vpn_switch_lock" 2>/dev/null; then
		echo "$name: another start holds $vpn_switch_lock"
		return 0
	fi
	trap 'rmdir "$vpn_switch_lock" 2>/dev/null' EXIT
	if connected; then
		echo "$name: session already connected"
		return 0
	fi
	wait_for_uplink || return 1
	echo "Starting VPN session${vpn_switch_session:+ $vpn_switch_session} for $vpn_switch_user ($vpn_switch_base)."
	# session start: with a name resumes that saved session, without it the
	# 'default' one; the connect steps run under the database's interpreter
	# pins (sudo sh), hence the passwordless-sudo requirement for the user.
	if [ -n "$vpn_switch_session" ]; then
		run_as_user "$vpn_switch_command" session start "$vpn_switch_session"
	else
		run_as_user "$vpn_switch_command" session start
	fi
}

# linkup: the devd hook - only when enabled, only after the boot's own
# start (pf and the routes are in place by then), quiet when connected
vpn_switch_linkup() {
	checkyesno vpn_switch_enable || return 0
	[ -f "$vpn_switch_started" ] || return 0
	connected && return 0
	vpn_switch_start
}

vpn_switch_stop() {
	vpn_switch_precheck || return 1
	echo "Stopping VPN sessions for $vpn_switch_user."
	run_as_user "$vpn_switch_command" stop
}

vpn_switch_status() {
	vpn_switch_precheck || return 1
	run_as_user "$vpn_switch_command" status
}

run_rc_command "$1"
